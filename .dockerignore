# .dockerignore — keep the Docker build context lean

# Node
frontend/node_modules/
frontend/dist/

# .NET build artifacts
src/**/bin/
src/**/obj/

# Distribution folder (not needed in Docker)
dist/

# Database files (created fresh in container)
**/*.db
**/*.db-shm
**/*.db-wal

# Logs
*.log

# IDE / OS
.vs/
.vscode/
.idea/
**/.DS_Store
**/Thumbs.db

# Git
.git/
.gitignore

# Docs
*.md
